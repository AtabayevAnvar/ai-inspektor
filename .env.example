# 1. Google Gemini API Kaliti (Majburiy - https://aistudio.google.com/app/apikey dan bepul olinadi)
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Google OAuth Client ID (Ixtiyoriy - agar kiritilmasa Demo login orqali kirish mumkin)
GOOGLE_CLIENT_ID=your_google_client_id_here

# 3. Supabase Cloud Database (Ixtiyoriy - kiritilmasa avtomatik ravishda SQLite ishlatiladi)
SUPABASE_URL=
SUPABASE_KEY=
